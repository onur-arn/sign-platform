# ─── Local (Postgres) ─────────────────────────────────────────
# Option A — Docker : docker compose up -d
# DATABASE_URL="postgresql://sign:sign@localhost:5432/sign_platform?schema=public"
# DIRECT_URL="postgresql://sign:sign@localhost:5432/sign_platform?schema=public"
#
# Option B — Neon (recommandé, gratuit) : https://console.neon.tech
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# (Sur Neon, DIRECT_URL = connection "direct"/non-pooled ; DATABASE_URL = pooled)

DATABASE_URL="postgresql://sign:sign@localhost:5432/sign_platform?schema=public"
DIRECT_URL="postgresql://sign:sign@localhost:5432/sign_platform?schema=public"

NEXTAUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SIGNS_CDN="https://pub-7da8c20292624389aac188ff567fa99f.r2.dev"

# Admin protégé + seed (jamais committer les vraies valeurs)
PROTECTED_ADMIN_EMAIL=""
NEXT_PUBLIC_PROTECTED_ADMIN_EMAIL=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Admin"
ADMIN_EMAIL=""
ADMIN_SECRET=""

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Optionnel — synonymes IA
ANTHROPIC_API_KEY=""

# ─── Production (Vercel) ──────────────────────────────────────
