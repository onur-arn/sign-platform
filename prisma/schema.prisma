generator client {
  provider = "prisma-client-js"
}

// Production : PostgreSQL (Neon / Vercel Postgres / Supabase)
// Local : même provider — pointe DATABASE_URL vers Neon ou un Postgres local.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  firstName    String?
  lastName     String?
  name         String?
  password     String
  status       String        @default("PENDING") // PENDING | APPROVED | REJECTED
  role         String        @default("USER") // USER | ADMIN
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  translations Translation[]
}

model Translation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  text      String
  type      String // "pdf", "text", "voice"
  fileUrl   String?
  createdAt DateTime @default(now())
}

model Sign {
  id           String   @id @default(cuid())
  word         String   @unique
  category     String?
  animationUrl String
  createdAt    DateTime @default(now())
}

model SynonymCache {
  id        String   @id @default(cuid())
  key       String   @unique // "lang:token"
  synonym   String? // null = aucun synonyme trouvé
  createdAt DateTime @default(now())
}

model RateLimitBucket {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}
